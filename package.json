{
    "name":  "cg-admin",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
                    "build":  "node ./node_modules/vite/bin/vite.js build",
                    "preview":  "node ./node_modules/vite/bin/vite.js preview",
                    "worker:dev":  "npm run build \u0026\u0026 node ./node_modules/wrangler/bin/wrangler.js dev",
                    "deploy":  "npm run build \u0026\u0026 node ./node_modules/wrangler/bin/wrangler.js deploy",
                    "test":  "node --test tests/*.test.js"
                },
    "dependencies":  {
                         "jose":  "^6.1.0",
                         "postal-mime":  "^4.2.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1"
                     },
    "devDependencies":  {
                            "vite":  "^6.4.1",
                            "wrangler":  "^4.155.0"
                        }
}