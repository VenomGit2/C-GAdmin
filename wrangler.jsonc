{
    "name":  "c-gadmin",
    "main":  "worker/index.js",
    "compatibility_date":  "2026-11-01",
    "workers_dev":  false,
    "preview_urls":  false,
    "assets":  {
                   "directory":  "./dist",
                   "binding":  "ASSETS",
                   "run_worker_first":  true,
                   "not_found_handling":  "single-page-application"
               },
    "d1_databases":  [
                         {
                             "binding":  "DB",
                             "database_name":  "circuitgrain-access",
                             "database_id":  "53695b42-59f9-4e1d-a045-954d7a8e2940",
                             "migrations_dir":  "schema-upgrades"
                         }
                     ],
    "vars":  {
                 "ADMIN_EMAILS":  "insanedk46@gmail.com",
                 "TURNSTILE_SITE_KEY":  "0x4AAAAAAFvUt93VBx4gGZD-",
                 "EMAIL_FROM":  "Circuit and Grain <requests@circuitgrain.shop>",
                 "INBOUND_REQUEST_ADDRESS":  "dnyaneshwar@circuitgrain.shop",
                 "INBOUND_FORWARD_TO":  "insanedk46@gmail.com",
                 "GOOGLE_CLIENT_ID":  "787849098588-ug81abf9bvgfjm67ik7dt7a3kc2psq3p.apps.googleusercontent.com",
                 "GOOGLE_REDIRECT_URI":  "https://admin.circuitgrain.shop/auth/google/callback"
             },
    "triggers":  {
                     "crons":  [
                                   "*/5 * * * *"
                               ]
                 },
    "routes":  [
                   {
                       "custom_domain":  true,
                       "pattern":  "admin.circuitgrain.shop"
                   },
                   {
                       "custom_domain":  true,
                       "pattern":  "request.circuitgrain.shop"
                   }
               ]
}